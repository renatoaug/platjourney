{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!data",
      "!dist",
      "!apps/web/src/styles/tailwind.css",
      "!db/demo-seed.json",
      "!apps/mobile/android",
      "!apps/mobile/ios"
    ]
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.html", "**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ],
  "plugins": [
    "./.biome/rules/no-raw-color.grit",
    "./.biome/rules/no-palette-token.grit",
    "./.biome/rules/no-hex-literal.grit"
  ],
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
