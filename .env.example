# PlayStation Network — NPSSO of a throwaway account used only to read public profiles
# (https://ca.account.sony.com/api/v1/ssocookie while logged in). Treat it like a password.
PSN_NPSSO=

# Telegram bot (@BotFather); each player links their own chat from the profile page
TELEGRAM_BOT_TOKEN=

# OpenAI — chat, guide research and embeddings
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Run the models on your own machine instead: any server that speaks the OpenAI API
# (LM Studio, mlx-lm, llama.cpp, Ollama). Free, no web search. After changing the
# embedding model, run `bun run embed --all`: vectors from different models do not compare.
AI_PROVIDER=openai
EMBEDDING_PROVIDER=openai
LOCAL_BASE_URL=http://localhost:1234/v1
LOCAL_MODEL=
LOCAL_EMBEDDING_MODEL=
# Thinking models on a laptop can think for minutes; none answers right away.
LOCAL_REASONING_EFFORT=none
# Caps each local reply, so a model stuck repeating itself stops.
LOCAL_MAX_TOKENS=2000
# A provider and model per feature, as provider or provider:model (openai:gpt-5.5,
# local:qwen3.6:35b-a3b, codex:gpt-5.5). Unset, the feature follows AI_PROVIDER. codex runs
# the Codex CLI signed in on this machine: for the evals, never for the app (docs/design/08-evals.md).
# Features: chat (Nexo's answers), tip (Nexo's notices), plan, recommend, guide,
# guide_index (deep guide), server_check, judge (grades answers in the evals).
AI_MODEL_CHAT=
AI_MODEL_TIP=
AI_MODEL_PLAN=
AI_MODEL_RECOMMEND=
AI_MODEL_GUIDE=
AI_MODEL_GUIDE_INDEX=
AI_MODEL_SERVER_CHECK=
AI_MODEL_JUDGE=

# IGDB (Twitch developer app) — the game catalog
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# SurrealDB (docker compose reads SURREAL_USER/SURREAL_PASS too)
SURREAL_URL=http://localhost:8000/rpc
SURREAL_USER=root
SURREAL_PASS=change-me
SURREAL_NS=platjourney
SURREAL_DB=main

# Optional
# POLL_MINUTES=15
# PORT=3000

# Accounts. Anyone can register a PSN ID with a password; the owner of the profile can claim it with a code in "About me".
SESSION_DAYS=30
# 1 when served over HTTPS.
COOKIE_SECURE=0
# 1 skips the "About me" check when claiming an account. Local development only.
AUTH_SKIP_VERIFICATION=0

# Where accounts are used from, to find one person behind many accounts. Empty records nothing.
# Only an HMAC of the IP address with this key is stored; generate one with `openssl rand -hex 32`.
ACCESS_HASH_SECRET=
# Days an address unused by an account is kept.
ACCESS_KEEP_DAYS=180
# 1 reads the client address from CF-Connecting-IP (Cloudflare) or the last X-Forwarded-For hop. Only behind a reverse proxy that sets them.
TRUST_PROXY=0
# Requests per minute one address may send to the API, every route together; over it, 429. Empty or 0 turns it off.
API_RATE_LIMIT=
# Assistants connected through MCP (/mcp): tool calls per minute each one may make (0 for no limit),
# and the days one stays signed in without being used.
MCP_RATE_LIMIT=60
MCP_REFRESH_DAYS=14

# Notices as push notifications in the browser and the installed web app (Web Push). Both keys
# come from `bun run --cwd apps/server push:keys`; empty turns push off. PUSH_CONTACT is a mailto:
# or https: address the push services can reach you at.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_CONTACT=

# AI service (services/ai). The server calls it with this shared token, 32 characters or more; generate one with `openssl rand -hex 24`.
AI_URL=http://127.0.0.1:8100
AI_TOKEN=
# Model work the app starts on its own (both default to 1). 0 = spend only when a player
# asks: AI_RESEARCH covers guide research, deep guide page search and server checks (all
# with web search); AI_NOTICES covers Nexo's notices on game start, trophies and session end.
# With AI_NOTICES=1 each player can still turn Nexo's notices off on the profile page; off, or
# with AI_NOTICES=0, notices are plain templates that need no model.
AI_RESEARCH=1
AI_NOTICES=1
# Hosted web search inside answers (OpenAI only). 0 = answers come from the stored guides,
# the deep guide passages and the catalog; questions the passages do not cover are listed in
# guide_request.
AI_WEB_SEARCH=1

# Plugins (docs/decisions/ADR-008-plugins.md): server modules to load at start, comma separated, and the
# web module that fills the interface slots, used at build time. Empty: no plugins.
PLUGINS=
PLUGINS_WEB=

# Evals (bun run ai:eval, docs/design/08-evals.md). Questions and runs go to their own database; each setting
# falls back to SURREAL_* (and the database to `evals`).
# EVAL_SURREAL_URL=
# EVAL_SURREAL_USER=
# EVAL_SURREAL_PASS=
# EVAL_SURREAL_NS=
# EVAL_SURREAL_DB=evals
# EVAL_VIEW_PORT=8200
