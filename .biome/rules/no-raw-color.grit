language css

CssGenericProperty() as $declaration where {
  $filename <: not r".*theme[.]css",
  $declaration <: r"(?s).*(?:#[0-9a-fA-F]{3,8}|rgba?[(]|hsla?[(]|oklch[(]).*",
  register_diagnostic(span=$declaration, message="Raw color. Use a semantic token, var(--color-*), from public/theme.css.")
}
