language js

or {
  JsStringLiteralExpression(),
  JsTemplateExpression()
} as $s where {
  $s <: r"(?s).*(?:#[0-9a-fA-F]{6}\b|#[0-9a-fA-F]{3}[;\"' )]|rgba?[(]).*",
  $filename <: r".*public/.*",
  register_diagnostic(span=$s, message="Raw color in markup. Use a class, or a semantic token (var(--color-*)) from public/theme.css.")
}
